# GMGN Callout OpenAPI credentials (server only — never NEXT_PUBLIC_).
# Apply at https://docs.gmgn.ai/index/gmgn-callout-openapi . The server's egress IP
# must be allowlisted by GMGN. Leave empty to run the demo replay of data/callouts-snapshot.json.
GMGN_AK=
GMGN_SK=

# Token being played. Defaults to the test token 0xfedf…7777 on BSC.
NEXT_PUBLIC_CHAIN=bsc
NEXT_PUBLIC_TOKEN_ADDRESS=0xfedf19759ba9c45b1a8345a2bde916b38acc7777
NEXT_PUBLIC_TOKEN_TICKER=$KING

# Seconds a call out must hold the hill to be crowned (5 minutes).
NEXT_PUBLIC_ROUND_SECONDS=300

# Break between a coronation and the next round (1 minute).
NEXT_PUBLIC_BREAK_SECONDS=60

# Only call outs from this moment count (ISO). Empty = everything GMGN returns.
NEXT_PUBLIC_GAME_START=

# Persistent archive of call outs (needed on Vercel so history keeps adding up).
# Add Upstash Redis from the Vercel Marketplace; it injects these. Locally,
# without them, the archive is .data/callouts.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
